# MongoDB connection string (the database name is appended automatically)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0

# Movie data: details, title search and posters (https://www.omdbapi.com)
OMDB_API_KEY=
# Optional poster fallback (https://fanart.tv)
FANART_API_KEY=
# Trailer lookup (YouTube Data API v3)
YOUTUBE_API_KEY=

# Payments
CURRENCY=inr
MIN_SHOW_PRICE=50
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Transactional email (Brevo or any SMTP provider)
SENDER_EMAIL=
SMTP_USER=
SMTP_PASS=

# Background jobs: confirmation emails, reminders, unpaid-booking cleanup.
# Optional. Locally run `npx inngest-cli@latest dev` instead of setting keys.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Auth
JWT_SECRET=a_long_random_string
# Comma-separated emails granted admin access
ADMIN_EMAILS=you@example.com
# Must match the client's VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
